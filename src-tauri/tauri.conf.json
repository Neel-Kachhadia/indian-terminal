{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BharatTerminal",
  "version": "0.1.0",
  "identifier": "com.indian-market-terminal.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BharatTerminal",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": [
      "../bundle-data/terminal.db.gz*",
      "../compute/models/**/*",
      "../compute/dist/bharatterminal-compute.exe",
      "../release/release-identity.json",
      "../release/resource-manifest.json",
      "../release/resource-manifest.sig",
      "../release/packaged-openapi.json"
      ,"../dist/**/*"
    ],
    "externalBin": ["../compute/dist/bharatterminal-compute"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
